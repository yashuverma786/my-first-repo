    color: white;
    padding: 12px;
    margin-bottom: 20px;
    text-align: center;
    font-size: 1.8rem;
    font-weight: 700;
    border-radius: 8px;
    letter-spacing: 0.05em;
  }
  .products p {
    font-size: 1.1rem;
    line-height: 1.6em;
    background-color: #f48fb1;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 2px 6px rgba(232, 75, 137, 0.4);
